# --- Database (PostgreSQL / Tiger Data / TimescaleDB) ---
# Tiger Data cloud example: postgresql+asyncpg://tsdbadmin:<password>@<host>.tsdb.cloud.timescale.com:<port>/tsdb
DATABASE_URL=postgresql+asyncpg://zeroday:zeroday@localhost:5432/zeroday
DATABASE_SSL=false
# Tiger Cloud uses its own CA: point this at Tiger's CA certificate (PEM) so TLS verifies.
DATABASE_SSL_ROOT_CERT=
ENABLE_TIMESCALE=true

# --- GitHub App ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=zeroday-score
# Either an inline PEM (use \n for newlines) or a path to the .pem file
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com

# --- LLM (OpenAI-compatible; NVIDIA NIM by default) ---
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# Optional fallback (any OpenAI-compatible endpoint), tried when the primary fails:
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai   model gemini-2.5-flash
#   Claude: https://api.anthropic.com/v1                              model claude-sonnet-5-5
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=90
# With no LLM key at all, scans run in deterministic-only mode.

# --- Nemotron agent ---
# Pass 1 runs as a tool-using agent (plan -> graph tools -> report); confirmed vulnerabilities
# get a patch that is re-scanned before it is offered. Opening fix PRs also needs the App's
# Contents and Pull requests permissions set to "Read & write".
AGENT_ENABLED=true
# Optional model for the agent's investigation turns only (same endpoint as LLM_MODEL). Leave
# empty: on NVIDIA's hosted API, nemotron-3.5-lightning-30b-a3b measured slower than Super here.
LLM_AGENT_MODEL=
# Nemotron "thinking" (hidden reasoning). Off for the agent's tool-choosing turns (~4x faster per
# turn, same findings in tests); keep it on for the skeptic and fixer (off made the skeptic
# double-count and the fixer stop proposing patches).
LLM_THINKING=true
LLM_AGENT_THINKING=false
AGENT_MAX_STEPS=10
AGENT_FIX_ENABLED=true
AGENT_OPEN_FIX_PRS=false
AGENT_MAX_FIXES=2

# --- App ---
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO
# Shared secret the Next.js server sends to the dashboard API (empty = open, dev only)
API_TOKEN=
# Comma-separated team slugs anyone may view read-only, even signed out (the demo team).
PUBLIC_TEAMS=
# GitHub sign-in on the deployed dashboard: the GitHub App's Client ID / Client secret.
# deploy/setup.sh copies them into the dashboard env as AUTH_GITHUB_ID / AUTH_GITHUB_SECRET.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
