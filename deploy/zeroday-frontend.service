[Unit]
Description=0 Days Since dashboard (Next.js)
After=network-online.target zeroday-backend.service
Wants=network-online.target

[Service]
User=zeroday
Group=zeroday
WorkingDirectory=/opt/zeroday/frontend
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3000 -H 127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/zeroday/frontend/.next

[Install]
WantedBy=multi-user.target
