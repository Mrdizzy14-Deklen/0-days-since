# FastAPI backend (server-to-server only; never exposed to the browser)
ZERODAY_API_URL=http://localhost:8000
# Must equal the backend's API_TOKEN. Leave empty only when the backend runs in open mode.
ZERODAY_API_TOKEN=

# GitHub sign-in (Auth.js). Leave AUTH_GITHUB_ID/SECRET empty for local demo mode (no sign-in).
# Use the GitHub App's own Client ID / secret (so team access follows its installations) and
# add the callback URL to the App: http://localhost:3000/api/auth/callback/github
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# AUTH_TRUST_HOST=true  # when running behind a proxy / on a custom host

# Demo mode only: GitHub login sent to the backend when it requires API_TOKEN.
DEMO_GITHUB_LOGIN=

# Slug of your GitHub App, for the "Install the GitHub App" button on the empty state.
NEXT_PUBLIC_GITHUB_APP_SLUG=
